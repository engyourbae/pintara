rules_version = '2';

// PINTARA — Firestore Security Rules (paket Spark, TANPA Cloud Functions).
// Semua validasi dilakukan di sini. Lihat docs/keamanan.md untuk alur, langkah admin, dan keterbatasan.
// Prinsip: tolak semua kecuali yang diizinkan eksplisit (least privilege).

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────── Helper umum ─────────────────────────
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }

    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function userData(uid) { return get(userPath(uid)).data; }
    function hasUserDoc() { return exists(userPath(request.auth.uid)); }
    function myRole() { return userData(request.auth.uid).role; }

    // Guru hanya sah bila ditandai teacherVerified = true secara manual lewat Firebase Console.
    function isTeacher() {
      return signedIn() && hasUserDoc()
        && userData(request.auth.uid).role == 'teacher'
        && userData(request.auth.uid).teacherVerified == true;
    }

    // Orang tua sah dari anak = parentUid di dokumen users anak itu menunjuk ke akun ini.
    function isParentOf(childUid) {
      return signedIn() && userData(childUid).get('parentUid', '') == request.auth.uid;
    }

    // Admin = ada dokumen admins/{uid} ATAU admins/{email-akun}. Dokumen dibuat manual lewat Firebase Console,
    // sehingga email admin tersimpan di Firestore, bukan di file rules/GitHub.
    function isAdmin() {
      return signedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || ('email' in request.auth.token
            && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))));
    }

    function validName(s) { return s is string && s.size() >= 1 && s.size() <= 30; }

    function pairId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }

    function blockedEither(a, b) {
      return exists(/databases/$(database)/documents/blocked_users/$(a + '_' + b))
        || exists(/databases/$(database)/documents/blocked_users/$(b + '_' + a));
    }

    // Izin orang tua per fitur untuk akun anak. Akun non-anak selalu lolos.
    function childOk(uid, flag) {
      return userData(uid).role != 'student'
        || get(/databases/$(database)/documents/parent_accounts/$(userData(uid).parentUid)/children/$(uid)).data[flag] == true;
    }

    // ───────────────────────── Akun & profil ─────────────────────────
    function validNewUser(uid) {
      let d = request.resource.data;
      return d.keys().hasAll(['role', 'displayName', 'teacherVerified', 'createdAt'])
        && d.keys().hasOnly(['role', 'displayName', 'teacherVerified', 'createdAt', 'parentUid', 'grade'])
        && d.role in ['student', 'parent', 'teacher']
        && d.teacherVerified == false
        && validName(d.displayName)
        && d.createdAt == request.time
        && (!('grade' in d.keys()) || (d.grade is int && d.grade >= 1 && d.grade <= 6))
        && (d.role == 'student'
            ? ('parentUid' in d.keys()
               && exists(/databases/$(database)/documents/parent_accounts/$(d.parentUid)/children/$(uid)))
            : !('parentUid' in d.keys()));
    }

    match /users/{uid} {
      allow get: if isUser(uid) || isAdmin() || (signedIn() && resource.data.get('parentUid', '') == request.auth.uid);
      // Hanya admin yang boleh melihat daftar akun (untuk menyetujui guru).
      allow list: if isAdmin();
      allow create: if isUser(uid) && validNewUser(uid);
      // Role, teacherVerified, parentUid tidak dapat diubah oleh pengguna.
      allow update: if (isUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'grade'])
        && validName(request.resource.data.displayName)
        && (!('grade' in request.resource.data.keys())
            || (request.resource.data.grade is int && request.resource.data.grade >= 1 && request.resource.data.grade <= 6)))
        // Admin hanya boleh menyetujui/menolak GURU: mengubah teacherVerified dan teacherRejected saja.
        || (isAdmin()
          && resource.data.role == 'teacher'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherVerified', 'teacherRejected'])
          && request.resource.data.teacherVerified is bool
          && request.resource.data.teacherRejected is bool);
      allow delete: if isUser(uid) || (signedIn() && resource.data.get('parentUid', '') == request.auth.uid);
    }

    // Penanda admin. Hanya bisa dibaca pemiliknya; dibuat manual lewat Console (tidak ada penulisan dari klien).
    match /admins/{adminId} {
      allow get: if signedIn() && (request.auth.uid == adminId
        || ('email' in request.auth.token && request.auth.token.email == adminId));
      allow list, write: if false;
    }

    // Pencarian teman: username -> uid. Hanya get (tidak bisa di-list). Unik karena create-only.
    match /usernames/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && hasUserDoc()
        && name.matches('[a-z0-9_]{3,20}')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if isUser(resource.data.uid);
    }

    // Profil publik MINIMAL (tanpa email, tanpa kelas, tanpa sekolah).
    match /user_profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isUser(uid) && hasUserDoc()
        && request.resource.data.keys().hasOnly(['username', 'avatarId'])
        && request.resource.data.keys().hasAll(['username', 'avatarId'])
        && request.resource.data.username is string
        && request.resource.data.avatarId is string
        && request.resource.data.avatarId.size() <= 30
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update: if isUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarId'])
        && request.resource.data.avatarId is string
        && request.resource.data.avatarId.size() <= 30;
      allow delete: if isUser(uid) || isParentOf(uid);
    }

    // ───────────────────────── Orang tua ─────────────────────────
    match /parent_accounts/{parentUid} {
      allow read: if isUser(parentUid);
      allow create: if isUser(parentUid) && hasUserDoc() && myRole() == 'parent'
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isUser(parentUid);

      // Pengaturan & izin per anak. Dibuat orang tua; dibaca orang tua dan anak itu sendiri.
      match /children/{childUid} {
        allow read: if isUser(parentUid) || isUser(childUid);
        allow create, update: if isUser(parentUid) && hasUserDoc() && myRole() == 'parent'
          && request.resource.data.keys().hasOnly(['displayName', 'friendsEnabled', 'multiplayerEnabled', 'dailyLimitMinutes'])
          && request.resource.data.keys().hasAll(['friendsEnabled', 'multiplayerEnabled', 'dailyLimitMinutes'])
          && request.resource.data.friendsEnabled is bool
          && request.resource.data.multiplayerEnabled is bool
          && request.resource.data.dailyLimitMinutes is int
          && request.resource.data.dailyLimitMinutes >= 0
          && request.resource.data.dailyLimitMinutes <= 600
          && (!('displayName' in request.resource.data.keys()) || validName(request.resource.data.displayName));
        allow delete: if isUser(parentUid);
      }
    }

    // ───────────────────────── Guru & kelas ─────────────────────────
    match /teacher_profiles/{uid} {
      allow read: if isUser(uid);
      allow create, update: if isUser(uid) && isTeacher()
        && request.resource.data.keys().hasOnly(['displayName', 'school'])
        && request.resource.data.keys().hasAll(['displayName'])
        && validName(request.resource.data.displayName)
        && (!('school' in request.resource.data.keys())
            || (request.resource.data.school is string && request.resource.data.school.size() <= 60));
      allow delete: if isUser(uid);
    }

    function classData(id) { return get(/databases/$(database)/documents/classes/$(id)).data; }
    function isClassTeacher(id) { return isTeacher() && classData(id).teacherUid == request.auth.uid; }
    function memberPath(id) { return /databases/$(database)/documents/class_members/$(id + '_' + request.auth.uid); }
    function isActiveMember(id) { return signedIn() && exists(memberPath(id)) && get(memberPath(id)).data.status == 'active'; }

    match /classes/{classId} {
      allow get: if isUser(resource.data.teacherUid) || isActiveMember(classId);
      // Guru melihat daftar kelasnya sendiri (query harus where teacherUid == uid).
      allow list: if isTeacher() && resource.data.teacherUid == request.auth.uid;
      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly(['name', 'grade', 'teacherUid', 'joinCode', 'archived', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'grade', 'teacherUid', 'joinCode', 'archived', 'createdAt'])
        && request.resource.data.teacherUid == request.auth.uid
        && validName(request.resource.data.name)
        && request.resource.data.grade is int && request.resource.data.grade >= 1 && request.resource.data.grade <= 6
        && request.resource.data.joinCode.matches('[A-Z0-9]{6}')
        && request.resource.data.archived == false
        && request.resource.data.createdAt == request.time;
      allow update: if isTeacher() && resource.data.teacherUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'grade', 'archived'])
        && validName(request.resource.data.name)
        && request.resource.data.grade is int && request.resource.data.grade >= 1 && request.resource.data.grade <= 6
        && request.resource.data.archived is bool;
      allow delete: if isTeacher() && resource.data.teacherUid == request.auth.uid;

      // Kuis buatan guru. Soal TANPA kunci jawaban; kunci ada di quiz_keys (hanya guru).
      match /quizzes/{quizId} {
        allow read: if isClassTeacher(classId) || isActiveMember(classId);
        // Dipakai sebagai "misi kelas": menunjuk paket kuis atau game yang harus dikerjakan murid.
        allow create: if isClassTeacher(classId)
          && request.resource.data.keys().hasOnly(['title', 'kind', 'contentId', 'note', 'createdAt'])
          && request.resource.data.keys().hasAll(['title', 'kind', 'contentId', 'note', 'createdAt'])
          && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 100
          && request.resource.data.kind in ['quiz', 'game']
          && request.resource.data.contentId is string && request.resource.data.contentId.size() >= 1 && request.resource.data.contentId.size() <= 60
          && request.resource.data.note is string && request.resource.data.note.size() <= 200
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isClassTeacher(classId);
      }
      match /quiz_keys/{quizId} {
        allow read, write: if isClassTeacher(classId);
      }

      // Kuis tulisan guru (F25). Soal tanpa kunci; kunci di quiz_keys/{id} (hanya guru).
      // Isi tiap soal (panjang teks, jumlah pilihan) hanya dibatasi di klien; Rules membatasi jumlah soal dan bidang.
      match /teacher_quizzes/{quizId} {
        allow read: if isClassTeacher(classId) || isActiveMember(classId);
        allow create: if isClassTeacher(classId)
          && request.resource.data.keys().hasOnly(['title', 'note', 'count', 'questions', 'createdAt'])
          && request.resource.data.keys().hasAll(['title', 'note', 'count', 'questions', 'createdAt'])
          && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 100
          && request.resource.data.note is string && request.resource.data.note.size() <= 200
          && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 20
          && request.resource.data.questions is list && request.resource.data.questions.size() == request.resource.data.count
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isClassTeacher(classId);
      }

      // Jawaban murid untuk kuis guru: satu dokumen per murid per kuis, sekali kirim (tanpa update).
      // Guru memberi kesempatan ulang dengan menghapusnya. Benar/salah dihitung guru dari quiz_keys.
      match /quiz_answers/{answerId} {
        allow read: if isClassTeacher(classId) || (isActiveMember(classId) && resource.data.uid == request.auth.uid);
        allow create: if isActiveMember(classId)
          && request.resource.data.keys().hasOnly(['uid', 'quizId', 'answers', 'submittedAt'])
          && request.resource.data.keys().hasAll(['uid', 'quizId', 'answers', 'submittedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.quizId is string
          && answerId == request.resource.data.quizId + '_' + request.auth.uid
          && request.resource.data.answers is list
          && request.resource.data.answers.size() == get(/databases/$(database)/documents/classes/$(classId)/teacher_quizzes/$(request.resource.data.quizId)).data.count
          && request.resource.data.submittedAt == request.time;
        allow update: if false;
        allow delete: if isClassTeacher(classId);
      }

      // Hasil latihan siswa. Ditulis siswa sendiri (atau guru dari kuis langsung) dan dapat diulang.
      match /results/{resultId} {
        allow read: if isClassTeacher(classId) || (isActiveMember(classId) && resource.data.uid == request.auth.uid);
        allow create, update: if (isClassTeacher(classId)
            || (isActiveMember(classId) && request.resource.data.uid == request.auth.uid))
          && request.resource.data.keys().hasOnly(['uid', 'quizId', 'score', 'correct', 'total', 'updatedAt'])
          && request.resource.data.keys().hasAll(['uid', 'quizId', 'score', 'correct', 'total', 'updatedAt'])
          && resultId == request.resource.data.quizId + '_' + request.resource.data.uid
          && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 100
          && request.resource.data.total is int && request.resource.data.total >= 1 && request.resource.data.total <= 100
          && request.resource.data.correct is int && request.resource.data.correct >= 0
          && request.resource.data.correct <= request.resource.data.total
          && request.resource.data.updatedAt == request.time;
        allow delete: if isClassTeacher(classId);
      }
    }

    // Kode kelas -> kelas. Siswa memakai get (tidak bisa mencari/list).
    match /class_codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly(['classId', 'teacherUid'])
        && request.resource.data.teacherUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.teacherUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.joinCode == code;
      allow delete: if isTeacher() && resource.data.teacherUid == request.auth.uid;
    }

    // Anggota kelas. ID dokumen = classId_uid. Siswa mengajukan (pending) dengan kode; guru menyetujui.
    match /class_members/{memberId} {
      allow read: if isUser(resource.data.uid) || isClassTeacher(resource.data.classId);
      allow create: if signedIn() && hasUserDoc() && myRole() == 'student'
        && request.resource.data.keys().hasOnly(['classId', 'uid', 'code', 'status', 'joinedAt', 'displayName'])
        && request.resource.data.keys().hasAll(['classId', 'uid', 'code', 'status', 'joinedAt', 'displayName'])
        && validName(request.resource.data.displayName)
        && request.resource.data.uid == request.auth.uid
        && memberId == request.resource.data.classId + '_' + request.resource.data.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.joinedAt == request.time
        && classData(request.resource.data.classId).archived == false
        && request.resource.data.code == classData(request.resource.data.classId).joinCode;
      allow update: if isClassTeacher(resource.data.classId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'groupId'])
        && request.resource.data.status in ['active', 'removed']
        && (!('groupId' in request.resource.data.keys())
            || (request.resource.data.groupId is string && request.resource.data.groupId.size() <= 20));
      allow delete: if isUser(resource.data.uid) || isClassTeacher(resource.data.classId);
    }

    // ───────────────────────── Konten (publik, hanya-baca) ─────────────────────────
    // Diisi admin lewat Firebase Console. Boleh dibaca tanpa login agar unduhan offline mudah.
    match /learning_categories/{id} { allow read: if true; allow write: if false; }
    match /learning_contents/{id}   { allow read: if true; allow write: if false; }
    match /games/{id}               { allow read: if true; allow write: if false; }
    match /achievements/{id}        { allow read: if true; allow write: if false; }

    // ───────────────────────── Progres & riwayat ─────────────────────────
    match /learning_progress/{uid} {
      allow read: if isUser(uid) || isParentOf(uid);
      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly(['xp', 'updatedAt'])
        && request.resource.data.keys().hasAll(['xp', 'updatedAt'])
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 1000
        && request.resource.data.updatedAt == request.time;
      // XP hanya naik, dan maksimal +1000 per penulisan (batas lunak: tanpa server, tidak anti-curang penuh).
      allow update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['xp', 'updatedAt'])
        && request.resource.data.xp is int
        && request.resource.data.xp >= resource.data.xp
        && request.resource.data.xp - resource.data.xp <= 1000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isUser(uid) || isParentOf(uid);

      match /items/{contentId} {
        allow read: if isUser(uid) || isParentOf(uid);
        allow create: if isUser(uid) && validItem(request.resource.data);
        allow update: if isUser(uid) && validItem(request.resource.data)
          && request.resource.data.attempts >= resource.data.attempts
          && request.resource.data.bestScore >= resource.data.bestScore;
        allow delete: if isUser(uid) || isParentOf(uid);
      }

      // Ringkasan kecil satu dokumen (rangkaian hari, skor game terbaik, hitungan) agar bisa dipulihkan setelah data peramban dihapus.
      match /snapshot/{docId} {
        allow read: if isUser(uid) || isParentOf(uid);
        allow create, update: if isUser(uid) && docId == 'main' && validSnapshot(request.resource.data);
        allow delete: if isUser(uid) || isParentOf(uid);
      }

      match /badges/{badgeId} {
        allow read: if isUser(uid) || isParentOf(uid);
        allow create: if isUser(uid)
          && exists(/databases/$(database)/documents/achievements/$(badgeId))
          && request.resource.data.keys().hasOnly(['earnedAt'])
          && request.resource.data.earnedAt == request.time;
        allow delete: if isUser(uid) || isParentOf(uid);
      }
    }

    function validSnapshot(d) {
      return d.keys().hasOnly(['streak', 'lastDay', 'answered', 'correct', 'games', 'updatedAt'])
        && d.keys().hasAll(['streak', 'lastDay', 'answered', 'correct', 'games', 'updatedAt'])
        && d.streak is int && d.streak >= 0 && d.streak <= 100000
        && d.lastDay is string && d.lastDay.size() <= 10
        && d.answered is int && d.answered >= 0 && d.answered <= 100000000
        && d.correct is int && d.correct >= 0 && d.correct <= 100000000
        && d.games is map && d.games.size() <= 40
        && d.updatedAt == request.time;
    }

    function validItem(d) {
      return d.keys().hasOnly(['bestScore', 'attempts', 'completed', 'version', 'lastPlayedAt'])
        && d.keys().hasAll(['bestScore', 'attempts', 'completed', 'version', 'lastPlayedAt'])
        && d.bestScore is int && d.bestScore >= 0 && d.bestScore <= 100
        && d.attempts is int && d.attempts >= 1 && d.attempts <= 100000
        && d.completed is bool
        && d.version is int
        && d.lastPlayedAt is timestamp && d.lastPlayedAt <= request.time;
    }

    // Riwayat permainan. ID dibuat klien (kunci idempotensi sinkronisasi offline). Tidak dapat diubah.
    match /game_sessions/{sessionId} {
      allow read: if isUser(resource.data.uid) || isParentOf(resource.data.uid);
      allow create: if isUser(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['uid', 'gameId', 'mode', 'score', 'correct', 'total', 'durationSec', 'playedAt'])
        && request.resource.data.keys().hasAll(['uid', 'gameId', 'mode', 'score', 'correct', 'total', 'durationSec', 'playedAt'])
        && request.resource.data.gameId is string && request.resource.data.gameId.size() <= 40
        && request.resource.data.mode in ['solo', 'duo', 'room', 'class']
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 10000
        && request.resource.data.total is int && request.resource.data.total >= 1 && request.resource.data.total <= 200
        && request.resource.data.correct is int && request.resource.data.correct >= 0
        && request.resource.data.correct <= request.resource.data.total
        && request.resource.data.durationSec is int && request.resource.data.durationSec >= 0 && request.resource.data.durationSec <= 7200
        && request.resource.data.playedAt is timestamp && request.resource.data.playedAt <= request.time;
      allow update: if false;
      allow delete: if isUser(resource.data.uid) || isParentOf(resource.data.uid);
    }

    // ───────────────────────── Pertemanan ─────────────────────────
    // Hanya akun anak (student) dengan izin orang tua yang boleh berteman. Guru/orang tua tidak bisa
    // mengirim permintaan ke anak. ID permintaan = fromUid_toUid.
    match /friend_requests/{reqId} {
      allow read: if isUser(resource.data.fromUid) || isUser(resource.data.toUid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['fromUid', 'toUid', 'status', 'createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && reqId == request.auth.uid + '_' + request.resource.data.toUid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && exists(userPath(request.resource.data.toUid))
        && myRole() == 'student'
        && userData(request.resource.data.toUid).role == 'student'
        && childOk(request.auth.uid, 'friendsEnabled')
        && childOk(request.resource.data.toUid, 'friendsEnabled')
        && !blockedEither(request.auth.uid, request.resource.data.toUid)
        && !exists(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, request.resource.data.toUid)));
      // Hanya penerima yang boleh menerima/menolak, dan hanya mengubah status.
      allow update: if isUser(resource.data.toUid)
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];
      // Pengirim boleh membatalkan yang pending; penerima boleh membersihkan.
      allow delete: if (isUser(resource.data.fromUid) && resource.data.status in ['pending', 'accepted'])
        || isUser(resource.data.toUid);
    }

    // Pertemanan hanya sah bila dibuat dalam batch yang sekaligus mengubah permintaan pending -> accepted
    // oleh penerima. ID dokumen = pasangan uid terurut.
    function otherUid(uids) { return uids[0] == request.auth.uid ? uids[1] : uids[0]; }
    function pendingReqPath(uids) {
      return /databases/$(database)/documents/friend_requests/$(otherUid(uids) + '_' + request.auth.uid);
    }

    match /friendships/{pairKey} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uids', 'createdAt'])
        && request.resource.data.keys().hasAll(['uids', 'createdAt'])
        && request.resource.data.uids is list
        && request.resource.data.uids.size() == 2
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.uids[0] < request.resource.data.uids[1]
        && pairKey == request.resource.data.uids[0] + '_' + request.resource.data.uids[1]
        && request.resource.data.createdAt == request.time
        && get(pendingReqPath(request.resource.data.uids)).data.status == 'pending'
        && getAfter(pendingReqPath(request.resource.data.uids)).data.status == 'accepted'
        && childOk(request.auth.uid, 'friendsEnabled')
        && !blockedEither(request.resource.data.uids[0], request.resource.data.uids[1]);
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.uids;
    }

    // Blokir. Hanya pemblokir yang bisa melihat/mengelola; pihak yang diblokir tidak diberi tahu.
    match /blocked_users/{blockId} {
      allow read: if isUser(resource.data.blockerUid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['blockerUid', 'blockedUid', 'createdAt'])
        && request.resource.data.keys().hasAll(['blockerUid', 'blockedUid', 'createdAt'])
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid is string
        && request.resource.data.blockedUid != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.blockedUid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isUser(resource.data.blockerUid);
    }

    // Laporan perilaku. Klien hanya bisa menulis; admin membaca lewat Firebase Console.
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterUid', 'reportedUid', 'reason', 'note', 'createdAt'])
        && request.resource.data.keys().hasAll(['reporterUid', 'reportedUid', 'reason', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reason in ['kasar', 'spam', 'informasi-pribadi', 'lainnya']
        && (!('note' in request.resource.data.keys())
            || (request.resource.data.note is string && request.resource.data.note.size() <= 300))
        && request.resource.data.createdAt == request.time;
    }

    // ───────────────────────── Undangan bermain ─────────────────────────
    // ID = fromUid_toUid (maksimal satu undangan aktif per arah). Berlaku 5 menit.
    function validInvite(d, id) {
      return d.keys().hasOnly(['fromUid', 'toUid', 'gameId', 'roomId', 'status', 'createdAt', 'expiresAt'])
        && d.keys().hasAll(['fromUid', 'toUid', 'gameId', 'roomId', 'status', 'createdAt', 'expiresAt'])
        && d.fromUid == request.auth.uid
        && d.toUid is string && d.toUid != d.fromUid
        && id == d.fromUid + '_' + d.toUid
        && d.gameId is string && d.gameId.size() >= 1 && d.gameId.size() <= 40
        && d.roomId is string && d.roomId.size() >= 10 && d.roomId.size() <= 40
        && d.status == 'pending'
        && d.createdAt == request.time
        && d.expiresAt is timestamp
        && d.expiresAt > request.time
        && d.expiresAt <= request.time + duration.value(5, 'm')
        && myRole() == 'student'
        && userData(d.toUid).role == 'student'
        && exists(/databases/$(database)/documents/friendships/$(pairId(d.fromUid, d.toUid)))
        && !blockedEither(d.fromUid, d.toUid)
        && childOk(d.fromUid, 'multiplayerEnabled')
        && childOk(d.toUid, 'multiplayerEnabled');
    }

    match /game_invitations/{invId} {
      allow read: if isUser(resource.data.fromUid) || isUser(resource.data.toUid);
      allow create: if signedIn() && validInvite(request.resource.data, invId);
      allow update: if
        // pengirim mengundang ulang (hanya jika undangan lama selesai atau kedaluwarsa)
        (isUser(resource.data.fromUid)
          && (resource.data.status != 'pending' || resource.data.expiresAt <= request.time)
          && validInvite(request.resource.data, invId))
        // pengirim membatalkan
        || (isUser(resource.data.fromUid)
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled')
        // penerima menjawab selama belum kedaluwarsa
        || (isUser(resource.data.toUid)
          && resource.data.status == 'pending'
          && resource.data.expiresAt > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['accepted', 'declined']);
      allow delete: if isUser(resource.data.fromUid);
    }
  }
}
