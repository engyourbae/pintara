# Salin menjadi .env.local lalu isi dari Firebase Console > Project settings > Your apps > Web app.
# Nilai ini config PUBLIK web (bukan rahasia); keamanan data dijaga oleh Security Rules.
# JANGAN pernah menaruh service account / private key di sini.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Wajib untuk Realtime Database, contoh: https://<project>-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=

# Base path GitHub Pages: '/<nama-repo>/'. Gunakan '/' untuk dev lokal / domain sendiri.
VITE_BASE_PATH=/pintara/
